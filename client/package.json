    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cypress": "^16.4.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^31.0.1",
